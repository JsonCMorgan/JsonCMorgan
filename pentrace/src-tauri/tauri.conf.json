{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenTrace",
  "version": "0.1.0",
  "identifier": "com.jsoncmorgan.pentrace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PenTrace",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#05010d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Neon cyberpunk hacking roguelite",
    "longDescription": "Breach simulated networks with real hacking concepts, get paid, upgrade your rig and fill the Index. Everything is simulated.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
